        <mxCell id="arch26" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;verticalAlign=top;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fbfbfb;dashed=1;" value='&lt;b style="font-size:14px"&gt;resolver.go — Iterative Resolution Engine&lt;/b&gt;'><mxGeometry x="20" y="280" width="600" height="320" as="geometry"/></mxCell>
        <mxCell id="arch27" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fff6dd;" value='&lt;b style="font-size:13px"&gt;Resolve loop&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;QNAME minimisation&lt;br&gt;referral walk, CNAME&lt;br&gt;glueless (max 3)&lt;/span&gt;'><mxGeometry x="40" y="330" width="180" height="130" as="geometry"/></mxCell>
        <mxCell id="arch28" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fff6dd;" value='&lt;b style="font-size:13px"&gt;Security checks&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;ID + question match&lt;br&gt;(UDP and TCP)&lt;br&gt;bailiwick: referral, glue&lt;/span&gt;'><mxGeometry x="230" y="330" width="180" height="130" as="geometry"/></mxCell>
        <mxCell id="arch29" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fff6dd;" value='&lt;b style="font-size:13px"&gt;Caches&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;answers: TTL ≤ 1 day&lt;br&gt;delegations expire&lt;br&gt;≤ 10,000 entries each&lt;/span&gt;'><mxGeometry x="420" y="330" width="180" height="130" as="geometry"/></mxCell>
        <mxCell id="arch210" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fff6dd;" value='&lt;b style="font-size:13px"&gt;Transport&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;UDP (EDNS0 1232, DO bit)  →  TCP when TC = 1&lt;/span&gt;'><mxGeometry x="40" y="490" width="560" height="90" as="geometry"/></mxCell>
