      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="arch22" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#e8f1fb;" value='&lt;b style="font-size:14px"&gt;CLI client&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;dnsr [-t TYPE] [-dnssec] &amp;lt;name&amp;gt;&lt;/span&gt;'><mxGeometry x="20" y="20" width="260" height="80" as="geometry"/></mxCell>
