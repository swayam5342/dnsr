        <mxCell id="arch24" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#f6ecf7;" value='&lt;b style="font-size:14px"&gt;main.go&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;flags, trace, colour, output&lt;/span&gt;'><mxGeometry x="20" y="150" width="260" height="80" as="geometry"/></mxCell>
