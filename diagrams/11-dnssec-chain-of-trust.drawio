<mxfile host="app.diagrams.net" pages="1">
  <diagram id="chain" name="DNSSEC Chain of Trust">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="chain2" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;fontStyle=1;" value="Parent publishes (signed)"><mxGeometry x="10" y="20" width="260" height="30" as="geometry"/></mxCell>
        <mxCell id="chain3" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;fontStyle=1;" value="Zone publishes (signed by itself)"><mxGeometry x="460" y="20" width="320" height="30" as="geometry"/></mxCell>
        <mxCell id="chain4" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fbfbfb;" value='&lt;b style="font-size:13px"&gt;Trust anchor (built in)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;root DS 20326 / 38696&lt;/span&gt;'><mxGeometry x="10" y="70" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="chain5" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fdeaea;" value='&lt;b style="font-size:13px"&gt;" . " DNSKEY set&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;KSK signs the DNSKEY RRset&lt;/span&gt;'><mxGeometry x="460" y="70" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="chain6" parent="1" edge="1" source="chain4" target="chain5" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;" value="digest matches a KSK"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="chain7" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fff6dd;" value='&lt;b style="font-size:13px"&gt;com. DS in root zone&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;RRSIG by a root key&lt;/span&gt;'><mxGeometry x="10" y="230" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="chain8" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fff6dd;" value='&lt;b style="font-size:13px"&gt;com. DNSKEY set&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;KSK signs the DNSKEY RRset&lt;/span&gt;'><mxGeometry x="460" y="230" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="chain9" parent="1" edge="1" source="chain7" target="chain8" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;" value="digest matches a KSK"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="chain10" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#eaf6ea;" value='&lt;b style="font-size:13px"&gt;cloudflare.com. DS in com.&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;RRSIG by a com. key&lt;/span&gt;'><mxGeometry x="10" y="390" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="chain11" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#eaf6ea;" value='&lt;b style="font-size:13px"&gt;cloudflare.com. DNSKEY set&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;KSK signs the DNSKEY RRset&lt;/span&gt;'><mxGeometry x="460" y="390" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="chain12" parent="1" edge="1" source="chain10" target="chain11" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;" value="digest matches a KSK"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="chain13" parent="1" edge="1" source="chain5" target="chain7" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="zone keys verify the child's DS"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="chain14" parent="1" edge="1" source="chain8" target="chain10" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="zone keys verify the child's DS"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="chain15" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#e8f1fb;" value='&lt;b style="font-size:13px"&gt;www.cloudflare.com. A + RRSIG&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;verified with cloudflare.com. zone keys&lt;/span&gt;'><mxGeometry x="300" y="550" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="chain16" parent="1" edge="1" source="chain11" target="chain15" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" value="keys verify the answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="chain17" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;align=left;verticalAlign=middle;fontStyle=2;" value="Any failure&lt;br&gt;→ bogus (SERVFAIL)&lt;br&gt;&lt;br&gt;No DS at a cut&lt;br&gt;→ insecure"><mxGeometry x="800" y="200" width="180" height="100" as="geometry"/></mxCell>
