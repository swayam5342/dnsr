<mxfile host="app.diagrams.net" pages="1">
  <diagram id="kam" name="Kaminsky-Style Cache Poisoning">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="kam2" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#f6ecf7;" value='&lt;b style="font-size:14px"&gt;Victim resolver&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;asks: random123.bank.com A&lt;br&gt;waits for ID match&lt;/span&gt;'><mxGeometry x="20" y="160" width="180" height="110" as="geometry"/></mxCell>
