        <mxCell id="kam4" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fdeaea;" value='&lt;b style="font-size:14px"&gt;Off-path attacker&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;floods guessed IDs&lt;/span&gt;'><mxGeometry x="580" y="290" width="200" height="90" as="geometry"/></mxCell>
