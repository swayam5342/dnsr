        <mxCell id="kam6" parent="1" edge="1" source="kam3" target="kam2" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;exitX=0;exitY=0.75;entryX=1;entryY=0.3;" value="real reply (may arrive late)"><mxGeometry relative="1" as="geometry"/></mxCell>
