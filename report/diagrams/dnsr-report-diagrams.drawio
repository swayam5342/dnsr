<mxfile host="app.diagrams.net" pages="13">
  <diagram id="arch2" name="System Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="arch22" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#e8f1fb;" value='&lt;b style="font-size:14px"&gt;CLI client&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;dnsr [-t TYPE] [-dnssec] &amp;lt;name&amp;gt;&lt;/span&gt;'><mxGeometry x="20" y="20" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="arch23" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#e8f1fb;" value='&lt;b style="font-size:14px"&gt;DNS clients&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;UDP / TCP :8053   DoT :853&lt;/span&gt;'><mxGeometry x="360" y="20" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="arch24" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#f6ecf7;" value='&lt;b style="font-size:14px"&gt;main.go&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;flags, trace, colour, output&lt;/span&gt;'><mxGeometry x="20" y="150" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="arch25" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#f6ecf7;" value='&lt;b style="font-size:14px"&gt;server.go&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;UDP + TCP + TLS 1.3 listeners&lt;br&gt;access list, rate limit, AD / TC&lt;/span&gt;'><mxGeometry x="360" y="150" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="arch26" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;verticalAlign=top;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fbfbfb;dashed=1;" value='&lt;b style="font-size:14px"&gt;resolver.go — Iterative Resolution Engine&lt;/b&gt;'><mxGeometry x="20" y="280" width="600" height="320" as="geometry"/></mxCell>
        <mxCell id="arch27" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fff6dd;" value='&lt;b style="font-size:13px"&gt;Resolve loop&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;QNAME minimisation&lt;br&gt;referral walk, CNAME&lt;br&gt;glueless (max 3)&lt;/span&gt;'><mxGeometry x="40" y="330" width="180" height="130" as="geometry"/></mxCell>
        <mxCell id="arch28" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fff6dd;" value='&lt;b style="font-size:13px"&gt;Security checks&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;ID + question match&lt;br&gt;(UDP and TCP)&lt;br&gt;bailiwick: referral, glue&lt;/span&gt;'><mxGeometry x="230" y="330" width="180" height="130" as="geometry"/></mxCell>
        <mxCell id="arch29" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fff6dd;" value='&lt;b style="font-size:13px"&gt;Caches&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;answers: TTL ≤ 1 day&lt;br&gt;delegations expire&lt;br&gt;≤ 10,000 entries each&lt;/span&gt;'><mxGeometry x="420" y="330" width="180" height="130" as="geometry"/></mxCell>
        <mxCell id="arch210" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fff6dd;" value='&lt;b style="font-size:13px"&gt;Transport&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;UDP (EDNS0 1232, DO bit)  →  TCP when TC = 1&lt;/span&gt;'><mxGeometry x="40" y="490" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="arch211" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#eaf6ea;" value='&lt;b style="font-size:14px"&gt;dnssec.go — Validator&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;root trust anchors&lt;br&gt;(KSK-2017 20326, KSK-2024 38696)&lt;br&gt;&lt;br&gt;DS → DNSKEY chain per zone&lt;br&gt;RRSIG check: RSA/SHA-2,&lt;br&gt;ECDSA P-256/P-384, Ed25519&lt;br&gt;&lt;br&gt;secure / insecure / bogus&lt;/span&gt;'><mxGeometry x="660" y="280" width="300" height="300" as="geometry"/></mxCell>
        <mxCell id="arch212" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#eaf6ea;" value='&lt;b style="font-size:14px"&gt;wire.go — RFC 1035 codec&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;A AAAA NS CNAME SOA PTR MX TXT DS DNSKEY RRSIG; 64-jump and 255-byte limits&lt;/span&gt;'><mxGeometry x="20" y="640" width="600" height="90" as="geometry"/></mxCell>
        <mxCell id="arch213" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fdeaea;" value='&lt;b style="font-size:14px"&gt;Internet: root, TLD,&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;authoritative servers (port 53)&lt;/span&gt;'><mxGeometry x="660" y="640" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="arch214" parent="1" edge="1" source="arch22" target="arch24" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;" value=""><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch215" parent="1" edge="1" source="arch23" target="arch25" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;startArrow=block;startFill=1;" value=""><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch216" parent="1" edge="1" source="arch24" target="arch26" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;exitX=0.5;exitY=1;entryX=0.22;entryY=0;" value=""><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch217" parent="1" edge="1" source="arch25" target="arch26" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;exitX=0.5;exitY=1;entryX=0.78;entryY=0;startArrow=block;startFill=1;" value=""><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch218" parent="1" edge="1" source="arch26" target="arch211" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;startArrow=block;startFill=1;" value=""><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch219" parent="1" edge="1" source="arch26" target="arch212" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.2;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;startArrow=block;startFill=1;" value=""><mxGeometry relative="1" as="geometry"/></mxCell>
