        <mxCell id="hier2" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fdeaea;" value='&lt;b style="font-size:13px"&gt;" . " (root)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;13 root server identities a–m&lt;/span&gt;'><mxGeometry x="380" y="20" width="160" height="70" as="geometry"/></mxCell>
