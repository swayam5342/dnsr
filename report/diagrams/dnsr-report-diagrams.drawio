  <diagram id="flow" name="Resolution Flowchart">
    <mxGraphModel dx="800" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Start: Resolve(name, type)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#e8f1fb;" vertex="1" parent="1">
          <mxGeometry x="240" y="24" width="240" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="In answer cache?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.2;fillColor=#fff6dd;fontStyle=1;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="240" y="96" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b style=&quot;font-size:12px&quot;&gt;Return cached RRs&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#eaf6ea;" vertex="1" parent="1">
          <mxGeometry x="536" y="108" width="168" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b style=&quot;font-size:13px&quot;&gt;Pick closest known zone&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;(delegation cache, else root hints)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="208" y="196" width="304" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b style=&quot;font-size:13px&quot;&gt;Send query to a server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;random ID, RD=0, EDNS0; TC → TCP&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="208" y="280" width="304" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Reply valid?&lt;br&gt;(ID + question)" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.2;fillColor=#fff6dd;fontStyle=1;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="240" y="368" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b style=&quot;font-size:12px&quot;&gt;Drop / try next server&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fdeaea;" vertex="1" parent="1">
          <mxGeometry x="8" y="380" width="184" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Response type?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.2;fillColor=#fff6dd;fontStyle=1;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="240" y="468" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:13px&quot;&gt;Answer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cache &amp;amp; return&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#eaf6ea;" vertex="1" parent="1">
          <mxGeometry x="528" y="416" width="176" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b style=&quot;font-size:13px&quot;&gt;CNAME&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;restart for target&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#eaf6ea;" vertex="1" parent="1">
          <mxGeometry x="528" y="496" width="176" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b style=&quot;font-size:12px&quot;&gt;NXDOMAIN / NODATA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;return with SOA&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#eaf6ea;" vertex="1" parent="1">
          <mxGeometry x="528" y="576" width="176" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b style=&quot;font-size:13px&quot;&gt;Referral (NS + glue)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="208" y="596" width="304" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="In bailiwick?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.2;fillColor=#fff6dd;fontStyle=1;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="240" y="680" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b style=&quot;font-size:12px&quot;&gt;Reject referral&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#fdeaea;" vertex="1" parent="1">
