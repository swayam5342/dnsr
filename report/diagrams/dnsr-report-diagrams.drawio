        <mxCell id="c18" value="&lt;b style=&quot;font-size:12px&quot;&gt;Cache zone → NS&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#ffffff;" vertex="1" parent="1">
