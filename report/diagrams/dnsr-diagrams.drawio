        <mxCell id="c12" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#eaf6ea;" value="&lt;b style=&quot;font-size:14px&quot;&gt;wire.go — RFC 1035 Codec&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;header / question / RR encode &amp;amp; decode, name compression&lt;br&gt;(0xC0 pointers, loop-limited), A, AAAA, NS, CNAME, SOA, PTR, MX, TXT, OPT&lt;/span&gt;" vertex="1">
