        <mxCell id="c3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#222222;strokeWidth=1.3;fontFamily=Times New Roman;fillColor=#e8f1fb;" value="&lt;b style=&quot;font-size:14px&quot;&gt;CLI Client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;dnsr [-t TYPE] [-q] &amp;lt;name&amp;gt;&lt;/span&gt;" vertex="1">
